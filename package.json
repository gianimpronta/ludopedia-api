{
  "name": "ludopedia-api",
  "version": "1.0.0",
  "description": "Cliente TypeScript / Node.js oficial não-oficial para a LudoAPI v1 da Ludopedia (OpenAPI 3.0).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ludopedia",
    "boardgames",
    "jogos-de-tabuleiro",
    "ludoapi",
    "bgg",
    "collection",
    "typescript",
    "api-client"
  ],
  "author": "BGHub Team <contato@bghub.com.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gianimpronta/ludopedia-api.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
